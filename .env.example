# Required: Claude API key for narration
ANTHROPIC_API_KEY=
# Optional: narration model (default claude-opus-5) and helper model (default claude-sonnet-5)
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_HELPER_MODEL=claude-sonnet-5

# Required: Google sign-in (Auth.js). Generate AUTH_SECRET with `npx auth secret`.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials with the
# redirect URI <your origin>/api/auth/callback/google.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Self-hosting (not Vercel): trust the Host header, or set AUTH_URL to your origin
# AUTH_TRUST_HOST=true
# Optional: restrict sign-in to these addresses and/or @domains (comma-separated)
# AUTH_ALLOWED_EMAILS=you@example.com,@your-school.edu
# Local development only (ignored in production builds): skip sign-in
# AUTH_DEV_BYPASS=1

# Required in production: shared store for usage limits (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Single-instance deployments only: use in-memory limits instead
# ALLOW_IN_MEMORY_LIMITS=1
# Optional limit overrides (defaults shown)
# LIMIT_NARRATIONS_PER_USER_DAY=20
# LIMIT_NARRATIONS_GLOBAL_DAY=500
# LIMIT_NARRATIONS_CONCURRENT=1
# LIMIT_VERIFY_PER_USER_DAY=20
# LIMIT_VERIFY_GLOBAL_DAY=500
# LIMIT_VERIFY_CONCURRENT=1
# LIMIT_TTS_CHARS_PER_USER_DAY=40000
# LIMIT_TTS_CHARS_GLOBAL_DAY=1000000
# LIMIT_TTS_CONCURRENT=3

# Text-to-speech: set one of these (Sarvam is preferred for Kannada)
SARVAM_API_KEY=
# SARVAM_TTS_SPEAKER=kavya
# GOOGLE_TTS_API_KEY=
# TTS_PROVIDER=sarvam
# TTS_CACHE_MAX_MB=200

# Optional: Project Gutenberg mirror for npm run corpus:fetch
# GUTENBERG_MIRROR=https://aleph.gutenberg.org
