# Required: Claude API key for narration
ANTHROPIC_API_KEY=
# Optional: narration model (default claude-opus-5) and helper model (default claude-sonnet-5)
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_HELPER_MODEL=claude-sonnet-5

# Text-to-speech: set one of these (Sarvam is preferred for Kannada)
SARVAM_API_KEY=
# SARVAM_TTS_SPEAKER=kavya
# GOOGLE_TTS_API_KEY=
# TTS_PROVIDER=sarvam

# Optional: Project Gutenberg mirror for npm run corpus:fetch
# GUTENBERG_MIRROR=https://aleph.gutenberg.org
